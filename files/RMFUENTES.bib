@article{valdivia_h2_2026,
	title = {H2 gain-scheduling dynamic output-feedback with {D}-stability applied to electronic systems},
	volume = {172},
	issn = {0967-0661},
	url = {https://www.sciencedirect.com/science/article/pii/S0967066126001255},
	doi = {https://doi.org/10.1016/j.conengprac.2026.106881},
	abstract = {This paper establishes novel synthesis conditions in terms of linear matrix inequalities (LMIs) for the design of a full-order dynamic output-feedback (DOF) controller for continuous-time Linear Parameter-Varying (LPV) systems. The proposed approach simultaneously minimizes the H2-guaranteed cost and ensures that the closed-loop eigenvalues (for a fixed operation point) stay within a predefined convex region of the complex plane. Additionally, the new conditions combine LMIs with fine-tuned scalar parameters to obtain less conservative results. The effectiveness of the control strategy is demonstrated through a Hardware-in-the-Loop (HIL) simulation of a DC-DC converter.},
	journal = {Control Engineering Practice},
	author = {Valdivia, S. A. and Fuentes, R. M. and Marciel, E. I. and Baier, C. R. and Morais, C. F. and Palma, J. M.},
	year = {2026},
	keywords = {Buck converter, Dynamic output feedback, Gain-scheduled control, Linear parameter varying, LMIs, norm, Projection lemma},
	pages = {106881},
	file = {ScienceDirect Full Text PDF:files/819/2026 - Valdivia et al. - H2mi mathvariant=script i.pdf:application/pdf;ScienceDirect Snapshot:files/818/S0967066126001255.html:text/html},
}

@inproceedings{fuentes_development_2021,
	title = {Development of solar energy in {Chile} and the world},
	url = {https://ieeexplore.ieee.org/abstract/document/9702985},
	doi = {10.1109/CHILECON54041.2021.9702985},
	abstract = {Chile is undoubtedly a country with potential when it comes to solar energy, but to understand this potential it is necessary to review the worldwide situation. This paper presents an analysis of the global situation and the geographic value that allows the a region to identify the potential for solar energy will be identified. This value turns out to favour the desert areas of the planet, since that is usually where the greatest irradiance is concentrated. A small projection of the elated energy situation in 2030 is mentioned. The regions of Chile are analysed individually, identifying the photovoltaic electricity potential throughout the country and identifying the current and future projects that try to take Chile to the pinnacle of photovoltaic electricity generation.},
	urldate = {2026-03-04},
	booktitle = {2021 {IEEE} {CHILEAN} {Conference} on {Electrical}, {Electronics} {Engineering}, {Information} and {Communication} {Technologies} ({CHILECON})},
	author = {Fuentes, Roberto and Rojas, Diego and Rivera, Marco and Riveros, José and Muñoz, Javier and Wheeler, Patrick and Rohten, Jaime},
	month = dec,
	year = {2021},
	keywords = {Concentrated solar power, Conferences, Electric potential, Information and communication technology, Irradiation, Nonconventional renewable energy, Photovoltaic, Photovoltaic systems, Planets, Renewable energy sources, Solar energy, World perspective},
	pages = {1--6},
	file = {Full Text PDF:files/821/2021 - Fuentes et al. - Development of solar energy in Chile and the world.pdf:application/pdf},
}

