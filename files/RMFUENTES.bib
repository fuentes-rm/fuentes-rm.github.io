@inproceedings{fuentes_reference_2025,
	title = {Reference tracking in sampled-data systems: a {DLMI}-based purely-discrete {PID} framework},
	booktitle = {2025 {IEEE} {CHILEAN} {Conference} on {Electrical}, {Electronics} {Engineering}, {Information} and {Communication} {Technologies} ({CHILECON})},
	author = {Fuentes, Roberto M. and de Oliveira, André M. and Gabriel, Gabriela W. and Lacerda, Márcio J. and Palma, Jonathan M.},
	month = oct,
	year = {2025},
	doi = {10.1109/CHILECON66915.2025.11476329},
	url = {https://doi.org/10.1109/CHILECON66915.2025.11476329},
	abstract = {This paper presents a tracking reference design condition based on a purely discrete-time PID controller aimed at sampled-data linear systems operating over hybrid time domains. The proposed method formulates the PID tuning problem as a convex optimization task based on Differential Linear Matrix Inequalities (DLMIs), with the specific objective of minimizing the H2 guaranteed cost of the tracking error signal. Purely discrete PID gains are obtained automatically without requiring model reduction or transformation to continuous-time domains. The resulting controller ensures stability and performance by imposing an H2 upper limit cost for hybrid systems. Numerical examples are used to show the effectiveness and practicality of the proposed method.},
	pdf = {/files/reference-tracking-sampled-data.pdf},
}

@article{fuentes_h_infty_2024,
	title = {{H∞} gain-scheduled dynamic output feedback control with transient performance applied to electrical microgrid},
	volume = {361},
	doi = {10.1016/j.jfranklin.2024.106704},
	url = {https://doi.org/10.1016/j.jfranklin.2024.106704},
	number = {7},
	journal = {Journal of the Franklin Institute},
	author = {Fuentes, Roberto M. and Lacerda, Márcio J. and Morais, Cecília F. and Oliveira, Ricardo C. L. F. and Palma, Jonathan M.},
	year = {2024},
	pages = {106704},
	abstract = {This paper introduces an approach for designing gain-scheduled dynamic output feedback controllers for continuous-time Linear Parameter-Varying (LPV) systems. The aim is to improve transient response by incorporating both D-stability and H∞ criteria into the synthesis conditions. We achieve this by employing changes of variables and congruence transformations, which lead to new synthesis conditions expressed as linear matrix inequalities. Additional fine-tuned scalar parameters can be used to enhance further the controller performance in terms of less conservative H∞ guaranteed costs. To assess the effectiveness of our proposed synthesis procedure, we conduct computational experiments in the context of a microinverter-based distributed power generation system.},
	pdf = {/files/h-infinity-gain-scheduled.pdf},
}

@article{valdivia_h2_2026,
	title = {{H₂} gain-scheduling dynamic output-feedback with {D}-stability applied to electronic systems},
	volume = {172},
	issn = {0967-0661},
	url = {https://doi.org/10.1016/j.conengprac.2026.106881},
	doi = {10.1016/j.conengprac.2026.106881},
	abstract = {This paper establishes novel synthesis conditions in terms of linear matrix inequalities (LMIs) for the design of a full-order dynamic output-feedback (DOF) controller for continuous-time Linear Parameter-Varying (LPV) systems. The proposed approach simultaneously minimizes the H2-guaranteed cost and ensures that the closed-loop eigenvalues (for a fixed operation point) stay within a predefined convex region of the complex plane. Additionally, the new conditions combine LMIs with fine-tuned scalar parameters to obtain less conservative results. The effectiveness of the control strategy is demonstrated through a Hardware-in-the-Loop (HIL) simulation of a DC-DC converter.},
	journal = {Control Engineering Practice},
	author = {Valdivia, S. A. and Fuentes, R. M. and Marciel, E. I. and Baier, C. R. and Morais, C. F. and Palma, J. M.},
	month = mar,
	year = {2026},
	keywords = {Buck converter, Dynamic output feedback, Gain-scheduled control, Linear parameter varying, LMIs, norm, Projection lemma},
	pages = {106881},
}

@inproceedings{fuentes_development_2021,
	title = {Development of solar energy in {Chile} and the world},
	url = {https://doi.org/10.1109/CHILECON54041.2021.9702985},
	doi = {10.1109/CHILECON54041.2021.9702985},
	abstract = {Chile is undoubtedly a country with potential when it comes to solar energy, but to understand this potential it is necessary to review the worldwide situation. This paper presents an analysis of the global situation and the geographic value that allows a region to identify the potential for solar energy. This value turns out to favour the desert areas of the planet, since that is usually where the greatest irradiance is concentrated. The regions of Chile are analysed individually, identifying the photovoltaic electricity potential throughout the country and current and future projects.},
	urldate = {2026-03-04},
	booktitle = {2021 {IEEE} {CHILEAN} {Conference} on {Electrical}, {Electronics} {Engineering}, {Information} and {Communication} {Technologies} ({CHILECON})},
	author = {Fuentes, Roberto and Rojas, Diego and Rivera, Marco and Riveros, José and Muñoz, Javier and Wheeler, Patrick and Rohten, Jaime},
	month = dec,
	year = {2021},
	pages = {1--6},
}

@article{fuentes_constant_2026,
	title = {Constant reference tracking control for uncertain linear sampled-data systems},
	volume = {59},
	issn = {1751-570X},
	url = {https://doi.org/10.1016/j.nahs.2025.101651},
	doi = {10.1016/j.nahs.2025.101651},
	abstract = {This paper studies the reference-tracking control problem for uncertain sampled-data systems with partial observation of the states. We show that, by robustly stabilizing the closed-loop system, the proposed digital controller ensures that the controlled output tracks constant set points. Moreover, new design conditions given in terms of Differential Linear Matrix Inequalities are presented for obtaining controllers with partial and complete measurements of the states. The design conditions are illustrated by numerical examples.},
	journal = {Nonlinear Analysis: Hybrid Systems},
	author = {Fuentes, Roberto M. and Gabriel, Gabriela W. and de Oliveira, André M. and Palma, Jonathan M.},
	month = feb,
	year = {2026},
	note = {Publisher: Elsevier BV},
	pages = {101651},
	pdf = {/files/constant-reference-tracking.pdf},
}

@article{fuentes_new_2025,
	title = {A {New} {Convex} {Approach} for {Grid}-{Supporting} {Inverter} {Control} {Based} on {DLMIs}},
	volume = {21},
	issn = {1941-0050},
	url = {https://doi.org/10.1109/TII.2025.3598523},
	doi = {10.1109/TII.2025.3598523},
	number = {12},
	journal = {IEEE Transactions on Industrial Informatics},
	author = {Fuentes, Roberto M. and Marciel, Esteban I. and Baier, Carlos R. and Gabriel, Gabriela W. and Morais, Cecilia F. and Lacerda, Márcio J. and Palma, Jonathan M.},
	month = dec,
	year = {2025},
	note = {Publisher: Institute of Electrical and Electronics Engineers (IEEE)},
	pages = {9631--9642},
	abstract = {The objective of this paper is to validate a dynamic output-feedback (DOF) control synthesis methodology to be implemented through digital signal processors (DSPs) in the scope of electrical microgrid applications. The DOF controller, originally designed in continuous-time, is developed aiming to comply with strict transient behavior requirements associated with electrical systems, by using an adaptation of the D-stability concept to handle linear parameter-varying (LPV) models. Additional contributions include a formulation based on Differential Linear Matrix Inequalities (DLMIs) to ensure the stability of the hybrid system and Hardware-in-the-Loop (HIL) validation on a three-phase grid-supporting inverter.},
	pdf = {/files/new-convex-approach.pdf},
}

@article{fuentes_gain-scheduled_2022,
	title = {Gain-{Scheduled} {Control} {Design} {Applied} to {Classical} dc–dc {Converters} in {Photovoltaic} {Systems} and {Constant} {Power} {Loads}},
	volume = {10},
	issn = {2227-7390},
	url = {https://doi.org/10.3390/math10193467},
	doi = {10.3390/math10193467},
	number = {19},
	journal = {Mathematics},
	author = {Fuentes, Roberto M. and Palma, Jonathan M. and Júnior, Hildo Guillardi and Lacerda, Márcio J. and Carvalho, Leonardo de P. and Rojas, Alejandro J. and Oliveira, Ricardo C. L. F.},
	month = sep,
	year = {2022},
	note = {Publisher: MDPI AG},
	pages = {3467},
	abstract = {This paper investigates the problem of control design for dc–dc converters, suitable to address variations in the input voltage in photovoltaic systems and constant power loads. The proposed approach models the converters in terms of Linear Parameter-Varying (LPV) models to compute gain-scheduled robust controllers with H∞ disturbance attenuation and D-stability pole location constraints. The validation is made via simulation of classical buck, boost, and buck-boost converters.},
	pdf = {/files/gain-scheduled-control.pdf},
}

